# Public — bundled into client JS, safe to expose to the browser.
# Used by the browser for direct calls to the NestJS backend (everything
# except auth, which goes through the Next.js BFF routes below).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-only — used exclusively by Next.js Route Handlers (app/api/auth/*)
# to reach the backend when proxying login/refresh/logout. Same value as
# NEXT_PUBLIC_API_URL in local dev; can point to an internal network URL in
# production without needing to expose that URL to the browser.
BACKEND_INTERNAL_API_URL=http://localhost:4000/api/v1
